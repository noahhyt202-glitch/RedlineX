-- pie / donut, drawn from thin radial strokes.  Data = { {"Wins", 60}, {"Losses", 30, Color3...} }
local function roundChart(self, o, donut)
	o = o or {}
	local H = o.Height or 210
	local f = Card(self, H, o)
	text(f, { Text = o.Name or (donut and "Donut chart" or "Pie chart"), Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -32, 0, 18) })
	local size = H - 56
	local circ = new("Frame", { Position = UDim2.fromOffset(18, 42), Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 }, f)
	local legend = new("Frame", { Position = UDim2.fromOffset(size + 40, 42), Size = UDim2.new(1, -(size + 58), 0, size), BackgroundTransparency = 1 }, f)
	new("UIListLayout", { Padding = UDim.new(0, 8), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, legend)
	local obj, data = {}, o.Data or {}
	local function draw()
		circ:ClearAllChildren()
		for _, c in ipairs(legend:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
		local slices, total = {}, 0
		for i, d in ipairs(data) do
			local n, v, c = sliceInfo(d, i)
			slices[#slices + 1] = { n = n, v = math.max(0, v), c = c }
			total += math.max(0, v)
		end
		if total <= 0 then return end
		local acc = 0
		for _, s in ipairs(slices) do s.a0 = acc / total acc += s.v s.a1 = acc / total end
		local R = size / 2
		local inner = donut and R * 0.6 or 0
		local N = 200
		local thick = math.ceil(2 * math.pi * R / N) + 2
		for k = 0, N - 1 do
			local a = (k + 0.5) / N
			local slice
			for _, s in ipairs(slices) do if a >= s.a0 and a < s.a1 then slice = s break end end
			-- leave a 1-step gap at the start of each slice (clean separation)
			if slice and (a - slice.a0) * N >= 1 then
				local ang = a * 2 * math.pi - math.pi / 2
				local len = R - inner
				local mid = inner + len / 2
				new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(R + math.cos(ang) * mid, R + math.sin(ang) * mid),
					Size = UDim2.fromOffset(len, donut and thick or math.max(2, thick)), Rotation = math.deg(ang), BackgroundColor3 = slice.c, BorderSizePixel = 0 }, circ)
			end
		end
		if donut then
			text(circ, { Text = o.Center or niceNum(total), Position = UDim2.new(0, 0, 0.5, -14), Size = UDim2.new(1, 0, 0, 22), Font = FONT_BL, TextSize = 18, TextXAlignment = CENTER, ZIndex = 3 })
			text(circ, { Text = o.CenterLabel or "Total", Position = UDim2.new(0, 0, 0.5, 8), Size = UDim2.new(1, 0, 0, 14), Font = FONT, TextSize = 10, TextColor3 = Theme.Dim,
				TextXAlignment = CENTER, ZIndex = 3 })
		end
		for i, s in ipairs(slices) do
			local row = new("Frame", { Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, LayoutOrder = i }, legend)
			local dot = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(8, 8), BackgroundColor3 = s.c }, row)
			corner(dot, 4)
			text(row, { Text = s.n, Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -70, 1, 0), Font = FONT, TextSize = 12, TextColor3 = Theme.Dim })
			text(row, { Text = math.floor(s.v / total * 100 + 0.5) .. "%", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(50, 16),
				TextSize = 12, TextXAlignment = RIGHT })
		end
	end
	task.defer(draw)
	function obj:Set(d) data = d or {} draw() end
	function obj:Get() return data end
	return obj
end
function Elements:PieChart(o) return roundChart(self, o, false) end
function Elements:DonutChart(o) return roundChart(self, o, true) end

