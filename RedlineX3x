	stroke(hcur, Color3.new(0, 0, 0), 0.5)
	local hex = new("TextBox", { Position = UDim2.fromOffset(0, 114), Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = Theme.Surface3, Font = FONT_B, TextSize = 12,
		TextColor3 = Theme.Text, Text = "", ClearTextOnFocus = false, ZIndex = 6 }, panel)
	corner(hex, 6)
	stroke(hex, Theme.Stroke)
	local sw, obj, open = {}, {}, false
	local function paint()
		preview.BackgroundColor3 = value
		sq.BackgroundColor3 = Color3.fromHSV(H_, 1, 1)
		cur.Position = UDim2.fromScale(S_, 1 - V_)
		hcur.Position = UDim2.fromScale(0.5, H_)
		if not hex:IsFocused() then hex.Text = toHex(value) end
		for _, s in ipairs(sw) do
			local on = s.c == value
			tween(s.st, 0.15, { Transparency = on and 0 or 1 })
			tween(s.f, 0.15, { Size = on and UDim2.fromOffset(22, 22) or UDim2.fromOffset(18, 18) })
		end
	end
	local function commit(silent)
		value = Color3.fromHSV(H_, S_, V_)
		if o.Flag then RedlineX.Flags[o.Flag] = value end
		paint()
		if not silent and o.Callback then task.spawn(o.Callback, value) end
	end
	function obj:Set(c, silent)
		if typeof(c) ~= "Color3" then return end
		H_, S_, V_ = c:ToHSV()
		value = c
		if o.Flag then RedlineX.Flags[o.Flag] = value end
		paint()
		if not silent and o.Callback then task.spawn(o.Callback, value) end
	end
	function obj:Get() return value end
	for i, c in ipairs(swatches) do
		local s = new("TextButton", { Size = UDim2.fromOffset(18, 18), BackgroundColor3 = c, Text = "", AutoButtonColor = false, LayoutOrder = i, ZIndex = 6 }, row)
		corner(s, 999)
		gloss(s)
		local st = stroke(s, Color3.new(1, 1, 1), 1, 2)
		s.MouseButton1Click:Connect(function() obj:Set(c) end)
		sw[#sw + 1] = { c = c, f = s, st = st }
	end
