--[[
	RedlineX  ·  UI library  ·  v1.0
	Glossy dark glass, red→orange "redline" accent, smooth everything.

	local RedlineX = loadstring(readfile("RedlineX.lua"))()
	local Win = RedlineX:CreateWindow({ Title = "My Hub", Subtitle = "by me", ToggleKey = Enum.KeyCode.RightShift })
	local Main = Win:Tab({ Name = "Main", Icon = "⚡", Desc = "the good stuff" })

	Main:Section("Combat-free stuff")
	Main:Toggle({ Name = "Auto thing", Desc = "does the thing", Default = true, Flag = "auto", Callback = function(on) end })
	Main:Slider({ Name = "Speed", Min = 0, Max = 100, Default = 50, Step = 1, Suffix = "%", Flag = "speed", Callback = function(v) end })
	Main:Dropdown({ Name = "Mode", Options = { "Safe", "Fast" }, Default = "Safe", Flag = "mode", Callback = function(v) end })
	Main:Dropdown({ Name = "Pick many", Options = { "A", "B", "C" }, Multi = true, Default = { "A" }, Callback = function(list) end })
	Main:Keybind({ Name = "Panic", Default = Enum.KeyCode.P, Callback = function() end })   -- Callback = pressed
	Main:Input({ Name = "Name", Placeholder = "type…", Callback = function(text, enter) end })
	Main:ColorPicker({ Name = "Color", Callback = function(c) end })
	Main:Button({ Name = "Do it", Desc = "click me", Callback = function() end })
	Main:Label("plain text")      Main:Paragraph({ Title = "Hi", Content = "long text…" })
	Win:SettingsTab()             -- theme / toggle key / configs / unload, prebuilt

	RedlineX:Notify({ Title = "Done", Content = "it worked", Type = "success", Duration = 4 })  -- info/success/warning/error
	RedlineX.Flags.speed          RedlineX:SaveConfig("main")   RedlineX:LoadConfig("main")
	RedlineX:SetAccent(Color3.fromRGB(80,160,255))    Win:Toggle()    Win:Destroy()
	Every element returns an object with :Set(value) and :Get().
]]

local RedlineX = { Flags = {}, Version = "1.0", _setters = {} }

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local TextService = game:GetService("TextService")
local lp = Players.LocalPlayer

local Theme = {
	Bg = Color3.fromRGB(10, 10, 14),
	Side = Color3.fromRGB(13, 13, 19),
	Surface = Color3.fromRGB(20, 20, 28),
	Surface2 = Color3.fromRGB(27, 27, 37),
	Surface3 = Color3.fromRGB(36, 36, 48),
	Stroke = Color3.fromRGB(44, 44, 58),
	Text = Color3.fromRGB(244, 244, 250),
	Dim = Color3.fromRGB(140, 140, 160),
	Accent = Color3.fromRGB(255, 46, 77),
	Accent2 = Color3.fromRGB(255, 128, 64),
	Success = Color3.fromRGB(64, 222, 140),
	Warning = Color3.fromRGB(255, 192, 64),
	Error = Color3.fromRGB(255, 70, 92),
}
RedlineX.Theme = Theme
local FONT, FONT_B, FONT_BL = Enum.Font.Gotham, Enum.Font.GothamBold, Enum.Font.GothamBlack
local LEFT, CENTER, RIGHT = Enum.TextXAlignment.Left, Enum.TextXAlignment.Center, Enum.TextXAlignment.Right
local MB1, TOUCH = Enum.UserInputType.MouseButton1, Enum.UserInputType.Touch

-- ===================== helpers =====================
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end
local function stroke(o, c, t, th)
	return new("UIStroke", { Color = c or Theme.Stroke, Transparency = t or 0, Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
local function pad(o, l, r, t, b)
	return new("UIPadding", { PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or 0), PaddingTop = UDim.new(0, t or 0), PaddingBottom = UDim.new(0, b or 0) }, o)
end
local function tween(o, t, props, style)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
local function text(parent, props)
	local base = { BackgroundTransparency = 1, Font = FONT_B, TextSize = 13, TextColor3 = Theme.Text, TextXAlignment = LEFT, TextYAlignment = Enum.TextYAlignment.Center }
	for k, v in pairs(props) do base[k] = v end
	return new("TextLabel", base, parent)
end
-- top-lit sheen: the "gloss"
local function gloss(o) return new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 212)) }, o) end
local accentGrads, accentFns = {}, {}
local function accentGradient(o, rot)
	local g = new("UIGradient", { Color = ColorSequence.new(Theme.Accent, Theme.Accent2), Rotation = rot or 0 }, o)
	accentGrads[#accentGrads + 1] = g
	return g
end
local function onAccent(fn) accentFns[#accentFns + 1] = fn fn() end
local function toKey(k)
	if typeof(k) == "EnumItem" then return k end
	if type(k) == "string" then
		local ok, e = pcall(function() return Enum.KeyCode[k] end)
		if ok then return e end
	end
	return Enum.KeyCode.Unknown
end
local function guiParent()
	local ok, h = pcall(function() return gethui and gethui() end)
	if ok and h then return h end
	local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
	if ok2 and cg then
		local test = Instance.new("Folder")
		if pcall(function() test.Parent = cg end) then test:Destroy() return cg end
	end
	return lp:WaitForChild("PlayerGui")
end

function RedlineX:SetAccent(a, b)
	Theme.Accent, Theme.Accent2 = a, b or a:Lerp(Color3.fromRGB(255, 170, 90), 0.45)
	for i = #accentGrads, 1, -1 do
		local g = accentGrads[i]
		if g.Parent then g.Color = ColorSequence.new(Theme.Accent, Theme.Accent2) else table.remove(accentGrads, i) end
	end
	for _, fn in ipairs(accentFns) do pcall(fn) end
end

-- ===================== notifications =====================
local notifyHolder
local function getNotifyHolder()
	if notifyHolder and notifyHolder.Parent and notifyHolder.Parent.Parent then return notifyHolder end
	local g = new("ScreenGui", { Name = "RedlineX_Notify", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 100,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, guiParent())
	notifyHolder = new("Frame", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -18, 1, -18), Size = UDim2.fromOffset(310, 600),
		BackgroundTransparency = 1 }, g)
	new("UIListLayout", { VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, notifyHolder)
	return notifyHolder
end
local nCount = 0
function RedlineX:Notify(o)
	o = o or {}
	local kind = o.Type or "info"
	local col = (kind == "success" and Theme.Success) or (kind == "warning" and Theme.Warning) or (kind == "error" and Theme.Error) or Theme.Accent
	local dur = o.Duration or 4
	local content = tostring(o.Content or "")
	local h = TextService:GetTextSize(content, 12, FONT, Vector2.new(254, 1000)).Y
	nCount += 1
	local wrap = new("Frame", { Size = UDim2.fromOffset(310, 48 + h + 10), BackgroundTransparency = 1, LayoutOrder = nCount }, getNotifyHolder())
	local card = new("Frame", { Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(340, 0), BackgroundColor3 = Theme.Surface }, wrap)
	corner(card, 12)
	stroke(card, Theme.Stroke)
	gloss(card)
	local bar = new("Frame", { Size = UDim2.new(0, 3, 1, -22), Position = UDim2.fromOffset(11, 11), BackgroundColor3 = col, BorderSizePixel = 0 }, card)
	corner(bar, 2)
	text(card, { Text = o.Title or "RedlineX", Position = UDim2.fromOffset(25, 11), Size = UDim2.new(1, -38, 0, 17), Font = FONT_BL, TextSize = 14 })
	text(card, { Text = content, Position = UDim2.fromOffset(25, 31), Size = UDim2.new(1, -38, 0, h), Font = FONT, TextSize = 12, TextColor3 = Theme.Dim,
		TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
	local prog = new("Frame", { Size = UDim2.new(1, -22, 0, 2), Position = UDim2.new(0, 11, 1, -6), BackgroundColor3 = col, BorderSizePixel = 0, BackgroundTransparency = 0.25 }, card)
	corner(prog, 1)
	tween(card, 0.45, { Position = UDim2.fromOffset(0, 0) })
	tween(prog, dur, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
	task.delay(dur, function()
		if not card.Parent then return end
		tween(card, 0.4, { Position = UDim2.fromOffset(340, 0) })
		task.wait(0.42)
		wrap:Destroy()
	end)
end

-- ===================== configs =====================
local function ser(v)
	local t = typeof(v)
	if t == "EnumItem" then return { __k = tostring(v.EnumType), n = v.Name } end
	if t == "Color3" then return { __c = { v.R, v.G, v.B } } end
	return v
end
local function deser(v)
	if type(v) == "table" then
		if v.__k then local ok, e = pcall(function() return Enum[v.__k][v.n] end) return ok and e or nil end
		if v.__c then return Color3.new(v.__c[1], v.__c[2], v.__c[3]) end
	end
	return v
end
function RedlineX:SaveConfig(name)
	if not writefile then return false end
	pcall(makefolder, "RedlineX")
	local t = {}
	for k, v in pairs(RedlineX.Flags) do t[k] = ser(v) end
	return pcall(writefile, "RedlineX/" .. (name or "default") .. ".json", HttpService:JSONEncode(t))
end
function RedlineX:LoadConfig(name)
	local path = "RedlineX/" .. (name or "default") .. ".json"
	if not (isfile and isfile(path)) then return false end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	if not ok then return false end
	for flag, v in pairs(data) do
		local s = RedlineX._setters[flag]
		if s then pcall(s, deser(v)) end
	end
	return true
end

-- ===================== elements =====================
local Elements = {}
Elements.__index = Elements
function Elements:_next() self._order += 1 return self._order end

local function Card(self, h)
	local f = new("Frame", { Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = Theme.Surface, LayoutOrder = self:_next() }, self._container)
	corner(f, 10)
	gloss(f)
	local st = stroke(f, Theme.Stroke)
	f.MouseEnter:Connect(function() tween(st, 0.2, { Color = Theme.Stroke:Lerp(Theme.Accent, 0.45) }) end)
	f.MouseLeave:Connect(function() tween(st, 0.2, { Color = Theme.Stroke }) end)
	return f, st
end
local function Titles(f, name, desc, rightSpace)
	rightSpace = rightSpace or 120
	if desc and desc ~= "" then
		text(f, { Text = name or "", Position = UDim2.fromOffset(14, 9), Size = UDim2.new(1, -rightSpace, 0, 17) })
		text(f, { Text = desc, Position = UDim2.fromOffset(14, 27), Size = UDim2.new(1, -rightSpace, 0, 15), Font = FONT, TextSize = 11, TextColor3 = Theme.Dim,
			TextTruncate = Enum.TextTruncate.AtEnd })
	else
		text(f, { Text = name or "", Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -rightSpace, 1, 0) })
	end
end
local function register(o, setter)
	if o.Flag then RedlineX._setters[o.Flag] = setter end
end

function Elements:Section(name)
	local f = new("Frame", { Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, LayoutOrder = self:_next() }, self._container)
	local bar = new("Frame", { Size = UDim2.fromOffset(3, 12), Position = UDim2.new(0, 2, 1, -15), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, f)
	corner(bar, 2)
	accentGradient(bar, 90)
	text(f, { Text = string.upper(name or ""), Position = UDim2.new(0, 12, 1, -19), Size = UDim2.new(1, -12, 0, 16), Font = FONT_BL, TextSize = 11, TextColor3 = Theme.Dim })
	return self
end

function Elements:Toggle(o)
	o = o or {}
	local value = o.Default == true
	local f = Card(self, (o.Desc and o.Desc ~= "") and 54 or 44)
	Titles(f, o.Name, o.Desc, 80)
	local track = new("Frame", { Size = UDim2.fromOffset(44, 24), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), BackgroundColor3 = Theme.Surface3 }, f)
	corner(track, 12)
	stroke(track, Theme.Stroke)
	local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1 }, track)
	corner(fill, 12)
	accentGradient(fill)
	local knob = new("Frame", { Size = UDim2.fromOffset(18, 18), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = Color3.fromRGB(200, 200, 214) }, track)
	corner(knob, 9)
	gloss(knob)
	local btn = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5 }, f)
	local obj = {}
	local function render()
		tween(fill, 0.22, { BackgroundTransparency = value and 0 or 1 })
		tween(knob, 0.25, { Position = value and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = value and Color3.new(1, 1, 1) or Color3.fromRGB(200, 200, 214) })
	end
	function obj:Set(v, silent)
		value = v and true or false
		if o.Flag then RedlineX.Flags[o.Flag] = value end
		render()
		if not silent and o.Callback then task.spawn(o.Callback, value) end
	end
	function obj:Get() return value end
	btn.MouseButton1Click:Connect(function() obj:Set(not value) end)
	obj:Set(value, true)
	register(o, function(v) obj:Set(v) end)
	return obj
end

function Elements:Slider(o)
	o = o or {}
	local min, max, step = o.Min or 0, o.Max or 100, o.Step or o.Increment or 1
	local dec = 0
	local frac = tostring(step):match("%.(%d+)")
	if frac then dec = #frac end
	local value = math.clamp(o.Default or min, min, max)
	local hasDesc = o.Desc and o.Desc ~= ""
	local f = Card(self, hasDesc and 70 or 56)
	text(f, { Text = o.Name or "", Position = UDim2.fromOffset(14, 9), Size = UDim2.new(1, -120, 0, 17) })
	if hasDesc then
		text(f, { Text = o.Desc, Position = UDim2.fromOffset(14, 27), Size = UDim2.new(1, -120, 0, 14), Font = FONT, TextSize = 11, TextColor3 = Theme.Dim })
	end
	local valBox = new("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 8), Size = UDim2.fromOffset(78, 22), BackgroundColor3 = Theme.Surface3,
		Font = FONT_B, TextSize = 12, TextColor3 = Theme.Text, Text = "" }, f)
	corner(valBox, 6)
	local bar = new("Frame", { Position = UDim2.new(0, 14, 1, -17), Size = UDim2.new(1, -28, 0, 6), BackgroundColor3 = Theme.Surface3, BorderSizePixel = 0 }, f)
	corner(bar, 3)
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, bar)
	corner(fill, 3)
	accentGradient(fill)
	local knob = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 3 }, bar)
	corner(knob, 7)
	local kst = stroke(knob, Theme.Accent, 0, 2)
	onAccent(function() kst.Color = Theme.Accent end)
	local hit = new("TextButton", { Position = UDim2.new(0, 6, 1, -30), Size = UDim2.new(1, -12, 0, 30), BackgroundTransparency = 1, Text = "", ZIndex = 5 }, f)
	local obj = {}
	local function fmt(v) return string.format("%." .. dec .. "f", v) .. (o.Suffix and (" " .. o.Suffix) or "") end
	local function render(anim)
		local r = (max > min) and (value - min) / (max - min) or 0
		if anim then
			tween(fill, 0.12, { Size = UDim2.fromScale(r, 1) })
			tween(knob, 0.12, { Position = UDim2.fromScale(r, 0.5) })
		else
			fill.Size, knob.Position = UDim2.fromScale(r, 1), UDim2.fromScale(r, 0.5)
		end
		valBox.Text = fmt(value)
	end
	function obj:Set(v, silent)
		v = math.clamp(tonumber(v) or min, min, max)
		v = math.floor((v - min) / step + 0.5) * step + min
		v = math.clamp(tonumber(string.format("%." .. dec .. "f", v)) or v, min, max)
		local changed = v ~= value
		value = v
		if o.Flag then RedlineX.Flags[o.Flag] = value end
		render(true)
		if changed and not silent and o.Callback then task.spawn(o.Callback, value) end
	end
	function obj:Get() return value end
	local function fromX(x)
		local r = math.clamp((x - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X), 0, 1)
		obj:Set(min + (max - min) * r)
	end
	local win = self._window
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == MB1 or i.UserInputType == TOUCH then
			win._drag = fromX
			win._dragEnd = function() tween(knob, 0.15, { Size = UDim2.fromOffset(14, 14) }) end
			tween(knob, 0.15, { Size = UDim2.fromOffset(18, 18) })
			fromX(i.Position.X)
		end
	end)
	if o.Flag then RedlineX.Flags[o.Flag] = value end
	render(false)
	register(o, function(v) obj:Set(v) end)
	return obj
end

function Elements:Button(o)
	o = o or {}
	local f = Card(self, (o.Desc and o.Desc ~= "") and 54 or 44)
	f.ClipsDescendants = true
	Titles(f, o.Name, o.Desc, 60)
	local arrow = text(f, { Text = "›", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, -1), Size = UDim2.fromOffset(20, 24), TextSize = 24,
		Font = FONT_BL, TextXAlignment = CENTER })
	onAccent(function() arrow.TextColor3 = Theme.Accent end)
	local btn = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5 }, f)
	btn.MouseButton1Click:Connect(function()
		local m = UIS:GetMouseLocation()
		local rp = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(m.X - f.AbsolutePosition.X, m.Y - f.AbsolutePosition.Y),
			Size = UDim2.fromOffset(0, 0), BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.65, ZIndex = 4 }, f)
		corner(rp, 999)
		local s = math.max(f.AbsoluteSize.X, f.AbsoluteSize.Y) * 2.2
		tween(rp, 0.6, { Size = UDim2.fromOffset(s, s), BackgroundTransparency = 1 })
		task.delay(0.65, function() rp:Destroy() end)
		tween(arrow, 0.1, { Position = UDim2.new(1, -8, 0.5, -1) })
		task.delay(0.1, function() tween(arrow, 0.25, { Position = UDim2.new(1, -14, 0.5, -1) }) end)
		if o.Callback then task.spawn(o.Callback) end
	end)
	return {}
end

function Elements:Dropdown(o)
	o = o or {}
	local options = o.Options or {}
	local multi = o.Multi == true
	local value
	if multi then
		value = {}
		for _, v in ipairs(o.Default or {}) do value[v] = true end
	else
		value = o.Default or options[1]
	end
	local HEAD = 46
	local f = Card(self, HEAD)
	f.ClipsDescendants = true
	text(f, { Text = o.Name or "", Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -210, 0, HEAD) })
	local selL = text(f, { Text = "", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -36, 0, 0), Size = UDim2.new(0, 180, 0, HEAD), Font = FONT, TextSize = 12,
		TextColor3 = Theme.Dim, TextXAlignment = RIGHT, TextTruncate = Enum.TextTruncate.AtEnd })
	local chev = text(f, { Text = "▾", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0, HEAD / 2), Size = UDim2.fromOffset(16, 16), TextSize = 14,
		TextXAlignment = CENTER, TextColor3 = Theme.Dim })
	local head = new("TextButton", { Size = UDim2.new(1, 0, 0, HEAD), BackgroundTransparency = 1, Text = "", ZIndex = 5 }, f)
	local list = new("Frame", { Position = UDim2.fromOffset(10, HEAD), Size = UDim2.new(1, -20, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, f)
	new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	local open = false
	local obj, optBtns = {}, {}
	local function label()
		if multi then
			local t = {}
			for _, op in ipairs(options) do if value[op] then t[#t + 1] = tostring(op) end end
			return #t > 0 and table.concat(t, ", ") or "None"
		end
		return value ~= nil and tostring(value) or "None"
	end
	local function paint()
		selL.Text = label()
		for _, it in ipairs(optBtns) do
			local on = (multi and value[it.op]) or (not multi and value == it.op)
			it.b.TextColor3 = on and Theme.Text or Theme.Dim
			it.b.BackgroundColor3 = on and Theme.Surface3 or Theme.Surface2
			it.dot.Visible = on and true or false
		end
	end
	local function height() return HEAD + (open and (#options * 34 + 6) or 0) end
	local function setOpen(v)
		open = v
		tween(f, 0.28, { Size = UDim2.new(1, 0, 0, height()) })
		tween(chev, 0.28, { Rotation = open and 180 or 0 })
	end
	function obj:Get()
		if multi then
			local t = {}
			for _, op in ipairs(options) do if value[op] then t[#t + 1] = op end end
			return t
		end
		return value
	end
	function obj:Set(v, silent)
		if multi then
			value = {}
			for _, x in ipairs(type(v) == "table" and v or {}) do value[x] = true end
		else
			value = v
		end
		paint()
		if o.Flag then RedlineX.Flags[o.Flag] = obj:Get() end
		if not silent and o.Callback then task.spawn(o.Callback, obj:Get()) end
	end
	local function build()
		for _, it in ipairs(optBtns) do it.b:Destroy() end
		optBtns = {}
		for i, op in ipairs(options) do
			local b = new("TextButton", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Theme.Surface2, Text = tostring(op), Font = FONT_B, TextSize = 12,
				TextColor3 = Theme.Dim, TextXAlignment = LEFT, AutoButtonColor = false, LayoutOrder = i }, list)
			corner(b, 7)
			pad(b, 12, 24)
			local dot = new("Frame", { Size = UDim2.fromOffset(6, 6), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 14, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1),
				Visible = false, BorderSizePixel = 0 }, b)
			corner(dot, 3)
			accentGradient(dot)
			b.MouseEnter:Connect(function() if b.TextColor3 ~= Theme.Text then tween(b, 0.15, { BackgroundColor3 = Theme.Surface3 }) end end)
			b.MouseLeave:Connect(function() paint() end)
			b.MouseButton1Click:Connect(function()
				if multi then
					value[op] = (not value[op]) or nil
					obj:Set(obj:Get())
				else
					obj:Set(op)
					setOpen(false)
				end
			end)
			optBtns[#optBtns + 1] = { b = b, dot = dot, op = op }
		end
		paint()
	end
	function obj:Refresh(newOptions, keep)
		options = newOptions or {}
		if not keep then if multi then value = {} else value = options[1] end end
		build()
		f.Size = UDim2.new(1, 0, 0, height())
	end
	head.MouseButton1Click:Connect(function() setOpen(not open) end)
	build()
	if o.Flag then RedlineX.Flags[o.Flag] = obj:Get() end
	register(o, function(v) obj:Set(v) end)
	return obj
end

function Elements:Keybind(o)
	o = o or {}
	local key = toKey(o.Default)
	local f = Card(self, (o.Desc and o.Desc ~= "") and 54 or 44)
	Titles(f, o.Name, o.Desc, 130)
	local b = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(100, 28), BackgroundColor3 = Theme.Surface3,
		Font = FONT_B, TextSize = 12, TextColor3 = Theme.Text, Text = "", AutoButtonColor = false, ZIndex = 6 }, f)
	corner(b, 7)
	local bst = stroke(b, Theme.Stroke)
	local listening = false
	local obj = {}
	local function paint()
		b.Text = listening and "press a key…" or (key == Enum.KeyCode.Unknown and "None" or key.Name)
		bst.Color = listening and Theme.Accent or Theme.Stroke
		b.TextColor3 = listening and Theme.Accent or Theme.Text
	end
	function obj:Set(k, silent)
		key = toKey(k)
		if o.Flag then RedlineX.Flags[o.Flag] = key end
		paint()
		if not silent and o.Changed then task.spawn(o.Changed, key) end
	end
	function obj:Get() return key end
	b.MouseButton1Click:Connect(function() listening = true paint() end)
	self._window:_conn(UIS.InputBegan:Connect(function(i, gp)
		if listening then
			if i.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				obj:Set(i.KeyCode == Enum.KeyCode.Escape and Enum.KeyCode.Unknown or i.KeyCode)
				RedlineX._ignoreUntil = os.clock() + 0.25
			end
			return
		end
		if gp or UIS:GetFocusedTextBox() or os.clock() < (RedlineX._ignoreUntil or 0) then return end
		if key ~= Enum.KeyCode.Unknown and i.KeyCode == key and o.Callback then task.spawn(o.Callback) end
	end))
	obj:Set(key, true)
	register(o, function(v) obj:Set(v) end)
	return obj
end

function Elements:Input(o)
