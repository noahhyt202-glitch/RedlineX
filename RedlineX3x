RedlineX.ChartColors = { Color3.fromRGB(116, 150, 255), Color3.fromRGB(176, 116, 255), Color3.fromRGB(96, 226, 240), Color3.fromRGB(242, 116, 204),
	Color3.fromRGB(255, 184, 72), Color3.fromRGB(84, 222, 144) }
local function sliceInfo(d, i)
	if type(d) ~= "table" then return tostring(i), tonumber(d) or 0, RedlineX.ChartColors[(i - 1) % #RedlineX.ChartColors + 1] end
	return tostring(d.Name or d[1] or i), tonumber(d.Value or d[2]) or 0, d.Color or d[3] or RedlineX.ChartColors[(i - 1) % #RedlineX.ChartColors + 1]
end
local function niceNum(v) if v == math.floor(v) then return tostring(v) end return string.format("%.1f", v) end

-- line chart with soft area fill.  Data = { 2, 4, 3, 7 }   :Set(newData)
function Elements:LineChart(o)
	o = o or {}
	local H = o.Height or 200
	local f = Card(self, H, o)
	text(f, { Text = o.Name or "Line chart", Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -32, 0, 18) })
	local plot = new("Frame", { Position = UDim2.fromOffset(48, 42), Size = UDim2.new(1, -66, 1, -58), BackgroundTransparency = 1 }, f)
	local obj, data = {}, o.Data or {}
	local function draw()
		plot:ClearAllChildren()
		local w, h = plot.AbsoluteSize.X, plot.AbsoluteSize.Y
		if w < 20 or h < 20 then return end
		local maxV = o.Max or 0
		if maxV == 0 then for _, v in ipairs(data) do maxV = math.max(maxV, tonumber(v) or 0) end end
		if maxV <= 0 then maxV = 1 end
		for i = 0, 3 do
			local y = h - h * (i / 3)
			new("Frame", { Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Theme.Stroke, BackgroundTransparency = 0.35, BorderSizePixel = 0 }, plot)
			text(plot, { Text = niceNum(maxV * i / 3), Position = UDim2.fromOffset(-40, y - 7), Size = UDim2.fromOffset(32, 14), Font = FONT, TextSize = 10,
				TextColor3 = Theme.Dim, TextXAlignment = RIGHT })
		end
		local pts = {}
		for i, v in ipairs(data) do
			local x = (#data == 1) and w / 2 or (i - 1) / (#data - 1) * w
			pts[i] = Vector2.new(x, h - math.clamp((tonumber(v) or 0) / maxV, 0, 1) * h)
		end
		-- area fill: thin columns under the line, fading down
		if #pts > 1 then
			local seg = 1
			for x = 0, w, 3 do
				while seg < #pts - 1 and x > pts[seg + 1].X do seg += 1 end
				local a, b = pts[seg], pts[seg + 1]
				local t = (b.X - a.X) > 0 and math.clamp((x - a.X) / (b.X - a.X), 0, 1) or 0
				local y = a.Y + (b.Y - a.Y) * t
				local col = new("Frame", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(3, math.max(0, h - y)), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0 }, plot)
				new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.72, 1) }, col)
			end
		end
		for i = 1, #pts - 1 do
