	local function sqDrag(p)
		S_ = math.clamp((p.X - sq.AbsolutePosition.X) / sq.AbsoluteSize.X, 0, 1)
		V_ = 1 - math.clamp((p.Y - sq.AbsolutePosition.Y) / sq.AbsoluteSize.Y, 0, 1)
		commit()
	end
	local function hueDrag(p)
		H_ = math.clamp((p.Y - hue.AbsolutePosition.Y) / hue.AbsoluteSize.Y, 0, 0.999)
		commit()
	end
	for _, pair in ipairs({ { sq, sqDrag }, { hue, hueDrag } }) do
		local hb = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5 }, pair[1])
		hb.InputBegan:Connect(function(i)
			if i.UserInputType == MB1 or i.UserInputType == TOUCH then win._drag = pair[2] pair[2](i.Position) end
		end)
	end
	hex.FocusLost:Connect(function() local c = fromHex(hex.Text) if c then obj:Set(c) else hex.Text = toHex(value) end end)
	obj:Set(value, true)
	register(o, function(v) obj:Set(v) end)
	return obj
end

