	corner(white, 8)
	new("UIGradient", { Transparency = NumberSequence.new(0, 1) }, white)
	local black = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, sq)
	corner(black, 8)
	new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, black)
