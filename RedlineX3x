function RedlineX:CreateWindow(opt)
	opt = opt or {}
	local W = { Tabs = {}, _conns = {}, ToggleKey = toKey(opt.ToggleKey or Enum.KeyCode.RightShift), Visible = true }
	function W:_conn(c) self._conns[#self._conns + 1] = c return c end
