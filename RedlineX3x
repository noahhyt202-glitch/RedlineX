function Elements:ColorPicker(o)
	o = o or {}
	local colors = o.Colors or {
		Color3.fromRGB(255, 46, 77), Color3.fromRGB(255, 128, 64), Color3.fromRGB(255, 205, 60), Color3.fromRGB(64, 222, 140),
		Color3.fromRGB(60, 210, 230), Color3.fromRGB(80, 140, 255), Color3.fromRGB(150, 100, 255), Color3.fromRGB(255, 90, 200), Color3.fromRGB(235, 235, 245),
	}
	local value = o.Default or colors[1]
	local f = Card(self, 46)
	Titles(f, o.Name, nil, #colors * 26 + 30)
	local row = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(#colors * 26, 22), BackgroundTransparency = 1 }, f)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, row)
	local sw, obj = {}, {}
	local function paint()
		for _, s in ipairs(sw) do
			local on = s.c == value
			tween(s.st, 0.15, { Transparency = on and 0 or 1 })
			tween(s.f, 0.15, { Size = on and UDim2.fromOffset(22, 22) or UDim2.fromOffset(18, 18) })
		end
	end
	function obj:Set(c, silent)
		value = c
		if o.Flag then RedlineX.Flags[o.Flag] = value end
		paint()
		if not silent and o.Callback then task.spawn(o.Callback, value) end
	end
	function obj:Get() return value end
	for i, c in ipairs(colors) do
		local s = new("TextButton", { Size = UDim2.fromOffset(18, 18), BackgroundColor3 = c, Text = "", AutoButtonColor = false, LayoutOrder = i, ZIndex = 6 }, row)
		corner(s, 999)
		gloss(s)
		local st = stroke(s, Color3.new(1, 1, 1), 1, 2)
		s.MouseButton1Click:Connect(function() obj:Set(c) end)
		sw[#sw + 1] = { c = c, f = s, st = st }
	end
	obj:Set(value, true)
	register(o, function(v) obj:Set(v) end)
	return obj
end

