	local hcur = new("Frame", { Size = UDim2.new(1, 4, 0, 4), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 4 }, hue)
