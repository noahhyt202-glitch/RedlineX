	corner(logo, 10)
	accentGradient(logo, 45)
	local logoShine = new("Frame", { Size = UDim2.new(1, -4, 0.5, -2), Position = UDim2.fromOffset(2, 2), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.78 }, logo)
	corner(logoShine, 8)
	text(logo, { Text = opt.Logo or "R", Size = UDim2.fromScale(1, 1), Font = FONT_BL, TextSize = 19, TextXAlignment = CENTER })
	text(header, { Text = title, Position = UDim2.fromOffset(62, 11), Size = UDim2.fromOffset(320, 19), Font = FONT_BL, TextSize = 16 })
	text(header, { Text = opt.Subtitle or ("RedlineX v" .. RedlineX.Version), Position = UDim2.fromOffset(62, 30), Size = UDim2.fromOffset(320, 15), Font = FONT, TextSize = 11, TextColor3 = Theme.Dim })
	local function hbtn(x, glyph, hoverCol)
