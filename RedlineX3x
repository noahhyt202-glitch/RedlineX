--[[
	if not RedlineX:KeySystem({
		Title = "My Hub", Subtitle = "Key required",
		Keys = { "redline-123" },                 -- valid keys, and/or
		KeyURL = "https://raw.githubusercontent.com/.../keys.txt",   -- one key per line (fetched)
		Validate = function(key) return true/false end,             -- or your own check
		GetKeyLink = "https://your-key-page",     -- copied by "Get key"
		SaveKey = true,                           -- remember a working key
	}) then return end
]]
function RedlineX:KeySystem(o)
	o = o or {}
	local title = o.Title or "RedlineX"
	local savePath = "RedlineX/key_" .. title:gsub("[^%w]", "") .. ".txt"
	local keys = {}
	for _, k in ipairs(o.Keys or {}) do keys[tostring(k)] = true end
	if o.KeyURL then
		local ok, body = pcall(function() return game:HttpGet(o.KeyURL) end)
		if ok and type(body) == "string" then
			for line in body:gmatch("[^\r\n]+") do
				local k = line:match("^%s*(.-)%s*$")
				if k ~= "" then keys[k] = true end
			end
		end
	end
	local function valid(k)
		k = tostring(k or ""):match("^%s*(.-)%s*$")
		if k == "" then return false end
		if o.Validate then local ok, r = pcall(o.Validate, k) return ok and r == true end
		return keys[k] == true
	end
	if o.SaveKey ~= false and isfile and isfile(savePath) then
		local ok, k = pcall(readfile, savePath)
		if ok and valid(k) then
			RedlineX:Notify({ Title = "Key accepted", Content = "Welcome back!", Type = "success", Duration = 3 })
			return true
		end
	end

	local gui = new("ScreenGui", { Name = "RedlineX_Key", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 90, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, guiParent())
	local dim = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1 }, gui)
	local card = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(400, 276), BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.08 }, gui)
	corner(card, 16)
	local cst = stroke(card, Color3.new(1, 1, 1), 0, 1.2)
	new("UIGradient", { Rotation = 35, Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Theme.Accent), ColorSequenceKeypoint.new(0.4, Theme.Stroke),
		ColorSequenceKeypoint.new(1, Theme.Stroke) }) }, cst)
	local cscale = new("UIScale", { Scale = 0.85 }, card)
	local glow = new("Frame", { Size = UDim2.fromOffset(320, 160), Position = UDim2.new(0.5, -160, 0, -110), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, card)
	corner(glow, 160)
	local gg = accentGradient(glow, 90)
	gg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.6, 0.82), NumberSequenceKeypoint.new(1, 0.96) })
	local logo = new("Frame", { Position = UDim2.fromOffset(24, 22), Size = UDim2.fromOffset(40, 40), BackgroundColor3 = Color3.new(1, 1, 1) }, card)
	corner(logo, 11)
	accentGradient(logo, 45)
	text(logo, { Text = o.Logo or "R", Size = UDim2.fromScale(1, 1), Font = FONT_BL, TextSize = 20, TextXAlignment = CENTER })
	text(card, { Text = title, Position = UDim2.fromOffset(76, 22), Size = UDim2.new(1, -120, 0, 20), Font = FONT_BL, TextSize = 17 })
	text(card, { Text = o.Subtitle or "Enter your key to continue", Position = UDim2.fromOffset(76, 44), Size = UDim2.new(1, -120, 0, 15), Font = FONT, TextSize = 12, TextColor3 = Theme.Dim })
	local closeB = new("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 18), Size = UDim2.fromOffset(28, 28), BackgroundTransparency = 1, Text = "✕",
		Font = FONT_B, TextSize = 14, TextColor3 = Theme.Dim }, card)
	text(card, { Text = "KEY", Position = UDim2.fromOffset(24, 84), Size = UDim2.fromOffset(100, 14), Font = FONT_BL, TextSize = 10, TextColor3 = Theme.Dim })
	local box = new("TextBox", { Position = UDim2.fromOffset(24, 102), Size = UDim2.new(1, -48, 0, 42), BackgroundColor3 = Theme.Surface2, BackgroundTransparency = 0.2,
		Font = FONT_B, TextSize = 13, TextColor3 = Theme.Text, PlaceholderText = "paste your key here…", PlaceholderColor3 = Theme.Dim, Text = "", ClearTextOnFocus = false,
		TextXAlignment = LEFT, ClipsDescendants = true }, card)
	corner(box, 10)
	pad(box, 14, 14)
	local bst = stroke(box, Theme.Stroke)
	box.Focused:Connect(function() tween(bst, 0.2, { Color = Theme.Accent }) end)
	box.FocusLost:Connect(function() tween(bst, 0.2, { Color = Theme.Stroke }) end)
	local status = text(card, { Text = o.Note or "Get a key, paste it above, then press Check key.", Position = UDim2.fromOffset(24, 152), Size = UDim2.new(1, -48, 0, 30),
		Font = FONT, TextSize = 12, TextColor3 = Theme.Dim, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
	local checkB = new("TextButton", { Position = UDim2.new(0, 24, 1, -66), Size = UDim2.new(0.5, -30, 0, 42), BackgroundColor3 = Color3.new(1, 1, 1), Text = "Check key",
		Font = FONT_BL, TextSize = 13, TextColor3 = Color3.new(1, 1, 1), AutoButtonColor = true }, card)
	corner(checkB, 10)
	accentGradient(checkB)
	local getB = new("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 1, -66), Size = UDim2.new(0.5, -30, 0, 42), BackgroundColor3 = Theme.Surface3,
		BackgroundTransparency = 0.2, Text = "Get key", Font = FONT_B, TextSize = 13, TextColor3 = Theme.Text, AutoButtonColor = true }, card)
	corner(getB, 10)
	stroke(getB, Theme.Stroke)

	local result = nil
	local function finish(r)
		if result ~= nil then return end
		result = r
		tween(dim, 0.25, { BackgroundTransparency = 1 })
		tween(cscale, 0.25, { Scale = 0.85 })
		task.delay(0.25, function() gui:Destroy() end)
	end
	local function shake()
		for _, x in ipairs({ -10, 9, -7, 5, -3, 0 }) do
			tween(card, 0.05, { Position = UDim2.new(0.5, x, 0.5, 0) }, Enum.EasingStyle.Linear)
			task.wait(0.05)
		end
	end
	local checking = false
	local function check()
		if checking then return end
		checking = true
		status.Text, status.TextColor3 = "Checking…", Theme.Dim
		local k = box.Text
		local ok = valid(k)
		if ok then
			if o.SaveKey ~= false and writefile then
				pcall(makefolder, "RedlineX")
				pcall(writefile, savePath, (k:match("^%s*(.-)%s*$")))
			end
			status.Text, status.TextColor3 = "✓  Key accepted, loading…", Theme.Success
			tween(bst, 0.2, { Color = Theme.Success })
			task.wait(0.6)
			finish(true)
		else
			status.Text, status.TextColor3 = "✕  That key isn't valid. Get a new one and try again.", Theme.Error
			tween(bst, 0.2, { Color = Theme.Error })
			shake()
		end
		checking = false
	end
	checkB.MouseButton1Click:Connect(function() task.spawn(check) end)
	box.FocusLost:Connect(function(enter) if enter then task.spawn(check) end end)
	getB.MouseButton1Click:Connect(function()
		if o.GetKeyLink and setclipboard then
			pcall(setclipboard, o.GetKeyLink)
			status.Text, status.TextColor3 = "Key link copied! Paste it in your browser.", Theme.Accent
		else
			status.Text, status.TextColor3 = o.GetKeyLink or "Ask the owner for a key.", Theme.Accent
		end
	end)
	closeB.MouseButton1Click:Connect(function() finish(false) end)
	tween(dim, 0.3, { BackgroundTransparency = 0.45 })
	tween(cscale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	repeat task.wait() until result ~= nil
	return result
end

