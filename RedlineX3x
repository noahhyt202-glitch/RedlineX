	local tabList = new("ScrollingFrame", { Size = UDim2.new(1, -16, 1, -84), Position = UDim2.fromOffset(8, 10), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, side)
	new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, tabList)
	-- profile card
	local prof = new("Frame", { Size = UDim2.new(1, -16, 0, 56), Position = UDim2.new(0, 8, 1, -64), BackgroundColor3 = Theme.Surface }, side)
	corner(prof, 10)
	gloss(prof)
	stroke(prof, Theme.Stroke)
	local av = new("ImageLabel", { Size = UDim2.fromOffset(36, 36), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = Theme.Surface3, Image = "" }, prof)
	corner(av, 18)
	local avSt = stroke(av, Theme.Accent, 0, 1.5)
	onAccent(function() avSt.Color = Theme.Accent end)
