	lg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.5, 0.75), NumberSequenceKeypoint.new(1, 0.92) })

	-- sidebar
	local side = new("Frame", { Size = UDim2.new(0, SIDE, 1, -59), Position = UDim2.fromOffset(0, 59), BackgroundColor3 = Theme.Side, BackgroundTransparency = 0.35, BorderSizePixel = 0 }, main)
