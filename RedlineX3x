	local content = new("Frame", { Size = UDim2.new(1, -SIDE - 1, 1, -59), Position = UDim2.fromOffset(SIDE + 1, 59), BackgroundTransparency = 1 }, main)

	-- minimized pill
	local pill = new("TextButton", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.fromOffset(240, 38), BackgroundColor3 = Theme.Surface,
		Text = "", Visible = false, AutoButtonColor = false }, gui)
	corner(pill, 19)
	gloss(pill)
	local pst = stroke(pill, Theme.Accent, 0.4)
	onAccent(function() pst.Color = Theme.Accent end)
	local pdot = new("Frame", { Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(9, 9), BackgroundColor3 = Color3.new(1, 1, 1) }, pill)
	corner(pdot, 10)
	accentGradient(pdot, 45)
	text(pdot, { Text = opt.Logo or "R", Size = UDim2.fromScale(1, 1), Font = FONT_BL, TextSize = 11, TextXAlignment = CENTER })
	local pillL = text(pill, { Text = "", Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -46, 1, 0), TextSize = 12 })

	-- fit to screen + open animation
	local baseScale = 1
	local function fit()
		local cam = workspace.CurrentCamera
		if not cam then return end
		local vp = cam.ViewportSize
		baseScale = math.clamp(math.min((vp.X - 30) / SW, (vp.Y - 30) / SH), 0.5, 1)
	end
	fit()
	if workspace.CurrentCamera then W:_conn(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function() fit() scaler.Scale = baseScale end)) end
	tween(scaler, 0.45, { Scale = baseScale }, Enum.EasingStyle.Back)

	function W:Toggle(v)
		if v == nil then v = not W.Visible end
		W.Visible = v
		if v then
			holder.Visible, pill.Visible = true, false
			scaler.Scale = baseScale * 0.92
			tween(scaler, 0.3, { Scale = baseScale }, Enum.EasingStyle.Back)
		else
			holder.Visible = false
			pillL.Text = title .. "  ·  " .. (W.ToggleKey.Name ~= "Unknown" and W.ToggleKey.Name or "tap") .. " to open"
			pill.Visible = true
			pill.Size = UDim2.fromOffset(200, 38)
			tween(pill, 0.3, { Size = UDim2.fromOffset(240, 38) }, Enum.EasingStyle.Back)
		end
	end
	function W:Destroy()
		for _, c in ipairs(W._conns) do pcall(function() c:Disconnect() end) end
		tween(scaler, 0.2, { Scale = baseScale * 0.9 })
		task.delay(0.15, function() gui:Destroy() end)
	end
	function W:Notify(o) RedlineX:Notify(o) end
	minB.MouseButton1Click:Connect(function() W:Toggle(false) end)
	pill.MouseButton1Click:Connect(function() W:Toggle(true) end)
	closeB.MouseButton1Click:Connect(function() W:Destroy() end)

	-- dragging (window + sliders), mouse and touch
	local dragging, dStart, dPos
	header.InputBegan:Connect(function(i)
		if i.UserInputType == MB1 or i.UserInputType == TOUCH then dragging, dStart, dPos = true, i.Position, holder.Position end
	end)
	W:_conn(UIS.InputChanged:Connect(function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= TOUCH then return end
		if W._drag then W._drag(i.Position.X) return end
		if dragging then
			local d = i.Position - dStart
			holder.Position = UDim2.new(dPos.X.Scale, dPos.X.Offset + d.X, dPos.Y.Scale, dPos.Y.Offset + d.Y)
		end
	end))
	W:_conn(UIS.InputEnded:Connect(function(i)
		if i.UserInputType == MB1 or i.UserInputType == TOUCH then
			dragging = false
			if W._dragEnd then W._dragEnd() end
			W._drag, W._dragEnd = nil, nil
		end
	end))
	W:_conn(UIS.InputBegan:Connect(function(i)
		if i.KeyCode == W.ToggleKey and W.ToggleKey ~= Enum.KeyCode.Unknown and not UIS:GetFocusedTextBox() and os.clock() > (RedlineX._ignoreUntil or 0) then W:Toggle() end
	end))

	-- tabs
	function W:SelectTab(T)
		for _, t in ipairs(W.Tabs) do
			local on = t == T
			t._page.Visible = on
			local x = t._btn
			tween(x.sel, 0.25, { BackgroundTransparency = on and 0.82 or 1 })
			tween(x.ind, 0.3, { Size = UDim2.fromOffset(3, on and 18 or 0) }, Enum.EasingStyle.Back)
			tween(x.nm, 0.2, { TextColor3 = on and Theme.Text or Theme.Dim })
			tween(x.ic, 0.2, { TextColor3 = on and Theme.Text or Theme.Dim })
		end
		T._container.Position = UDim2.fromOffset(12, 70)
		tween(T._container, 0.35, { Position = UDim2.fromOffset(12, 60) })
		W.Current = T
	end
	function W:Tab(o)
		o = type(o) == "string" and { Name = o } or (o or {})
		local T = setmetatable({ _window = W, _order = 0 }, Elements)
		local b = new("TextButton", { Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.Surface2, BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
			LayoutOrder = #W.Tabs + 1 }, tabList)
		corner(b, 9)
		local sel = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1 }, b)
		corner(sel, 9)
		accentGradient(sel)
		local ind = new("Frame", { Size = UDim2.fromOffset(3, 0), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0 }, b)
		corner(ind, 2)
		accentGradient(ind, 90)
		local ic = text(b, { Text = o.Icon or "•", Position = UDim2.fromOffset(12, 0), Size = UDim2.fromOffset(22, 38), TextXAlignment = CENTER, TextSize = 15, TextColor3 = Theme.Dim })
		local nm = text(b, { Text = o.Name or "Tab", Position = UDim2.fromOffset(42, 0), Size = UDim2.new(1, -48, 1, 0), TextSize = 13, TextColor3 = Theme.Dim })
		b.MouseEnter:Connect(function() if W.Current ~= T then tween(b, 0.15, { BackgroundTransparency = 0.5 }) end end)
		b.MouseLeave:Connect(function() tween(b, 0.15, { BackgroundTransparency = 1 }) end)
		local page = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false }, content)
		text(page, { Text = o.Name or "Tab", Position = UDim2.fromOffset(20, 12), Size = UDim2.new(1, -40, 0, 24), Font = FONT_BL, TextSize = 20 })
		text(page, { Text = o.Desc or "", Position = UDim2.fromOffset(20, 36), Size = UDim2.new(1, -40, 0, 14), Font = FONT, TextSize = 11, TextColor3 = Theme.Dim })
		local scroll = new("ScrollingFrame", { Position = UDim2.fromOffset(12, 60), Size = UDim2.new(1, -18, 1, -64), BackgroundTransparency = 1, BorderSizePixel = 0,
			ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y }, page)
		onAccent(function() scroll.ScrollBarImageColor3 = Theme.Accent end)
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
		pad(scroll, 6, 12, 2, 14)
		T._container, T._page, T._btn = scroll, page, { b = b, sel = sel, ind = ind, ic = ic, nm = nm }
		b.MouseButton1Click:Connect(function() W:SelectTab(T) end)
		table.insert(W.Tabs, T)
		if #W.Tabs == 1 then W:SelectTab(T) end
		return T
	end

	-- prebuilt settings tab
	function W:SettingsTab()
		local T = W:Tab({ Name = "Settings", Icon = "⚙", Desc = "theme, keybind and configs" })
