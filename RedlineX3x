	gloss(pill)
	local pst = stroke(pill, Theme.Accent, 0.4)
	onAccent(function() pst.Color = Theme.Accent end)
	local pdot = new("Frame", { Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(9, 9), BackgroundColor3 = Color3.new(1, 1, 1) }, pill)
	corner(pdot, 10)
	accentGradient(pdot, 45)
	text(pdot, { Text = opt.Logo or "R", Size = UDim2.fromScale(1, 1), Font = FONT_BL, TextSize = 11, TextXAlignment = CENTER })
	local pillL = text(pill, { Text = "", Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -46, 1, 0), TextSize = 12 })

	-- fit to screen
	local baseScale = 1
	local function fit()
		local cam = workspace.CurrentCamera
		if not cam then return end
		local vp = cam.ViewportSize
		baseScale = math.clamp(math.min((vp.X - 30) / SW, (vp.Y - 30) / SH), 0.5, 1)
	end
	fit()
	if workspace.CurrentCamera then W:_conn(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function() fit() scaler.Scale = baseScale end)) end

	function W:SetTransparency(t)
		glassT = math.clamp(t, 0, 0.8)
		main.BackgroundTransparency = glassT
	end
	function W:Toggle(v)
		if v == nil then v = not W.Visible end
		W.Visible = v
		if v then
			holder.Visible, pill.Visible = true, false
			scaler.Scale = baseScale * 0.92
			tween(scaler, 0.3, { Scale = baseScale }, Enum.EasingStyle.Back)
		else
			holder.Visible = false
			tip.Visible = false
			pillL.Text = title .. "  ·  " .. (W.ToggleKey.Name ~= "Unknown" and W.ToggleKey.Name or "tap") .. " to open"
			pill.Visible = true
			pill.Size = UDim2.fromOffset(210, 38)
			tween(pill, 0.3, { Size = UDim2.fromOffset(250, 38) }, Enum.EasingStyle.Back)
		end
	end
	function W:Destroy()
		for _, c in ipairs(W._conns) do pcall(function() c:Disconnect() end) end
		tween(scaler, 0.2, { Scale = baseScale * 0.9 })
		task.delay(0.15, function() gui:Destroy() end)
	end
	function W:Notify(o) RedlineX:Notify(o) end

	-- maximize / restore
	local maxed, prevSize, prevPos = false, nil, nil
	maxB.MouseButton1Click:Connect(function()
		local cam = workspace.CurrentCamera
		if not cam then return end
		if not maxed then
			prevSize, prevPos = holder.Size, holder.Position
			local vp = cam.ViewportSize
			tween(holder, 0.35, { Size = UDim2.fromOffset(vp.X * 0.94 / scaler.Scale, vp.Y * 0.9 / scaler.Scale), Position = UDim2.fromScale(0.5, 0.5) })
			maxB.Text = "⤡"
		else
			tween(holder, 0.35, { Size = prevSize, Position = prevPos })
			maxB.Text = "⤢"
		end
		maxed = not maxed
	end)
	minB.MouseButton1Click:Connect(function() W:Toggle(false) end)
	pill.MouseButton1Click:Connect(function() W:Toggle(true) end)

	-- dragging (window by the brand / page header, sliders, color picker, resize grip)
	local dragging, dStart, dPos
	for _, h in ipairs({ brand, top }) do
		h.InputBegan:Connect(function(i)
			if i.UserInputType == MB1 or i.UserInputType == TOUCH then dragging, dStart, dPos = true, i.Position, holder.Position end
		end)
	end
	grip.InputBegan:Connect(function(i)
		if i.UserInputType == MB1 or i.UserInputType == TOUCH then
			local s0, p0, size0 = i.Position, holder.Position, holder.AbsoluteSize / scaler.Scale
			W._drag = function(p)
				local sc = scaler.Scale
				local nw = math.max(600, size0.X + (p.X - s0.X) / sc)
				local nh = math.max(380, size0.Y + (p.Y - s0.Y) / sc)
				holder.Size = UDim2.fromOffset(nw, nh)
				holder.Position = UDim2.new(p0.X.Scale, p0.X.Offset + (nw - size0.X) * sc / 2, p0.Y.Scale, p0.Y.Offset + (nh - size0.Y) * sc / 2)
			end
		end
	end)
	W:_conn(UIS.InputChanged:Connect(function(i)
		if i.UserInputType ~= MOVE and i.UserInputType ~= TOUCH then return end
		if tip.Visible then
			local m = UIS:GetMouseLocation()
			tip.Position = UDim2.fromOffset(m.X + 14, m.Y + 16)
		end
		if W._drag then W._drag(i.Position) return end
		if dragging then
			local d = i.Position - dStart
			holder.Position = UDim2.new(dPos.X.Scale, dPos.X.Offset + d.X, dPos.Y.Scale, dPos.Y.Offset + d.Y)
		end
	end))
	W:_conn(UIS.InputEnded:Connect(function(i)
		if i.UserInputType == MB1 or i.UserInputType == TOUCH then
			dragging = false
			if W._dragEnd then W._dragEnd() end
			W._drag, W._dragEnd = nil, nil
		end
	end))
	W:_conn(UIS.InputBegan:Connect(function(i)
		if i.KeyCode == W.ToggleKey and W.ToggleKey ~= Enum.KeyCode.Unknown and not UIS:GetFocusedTextBox() and os.clock() > (RedlineX._ignoreUntil or 0) then W:Toggle() end
	end))

	-- phones/tablets: floating button to open/close (drag it anywhere)
	if UIS.TouchEnabled and not UIS.KeyboardEnabled then
		local fab = new("TextButton", { Size = UDim2.fromOffset(48, 48), Position = UDim2.new(0, 14, 0.45, 0), BackgroundColor3 = Color3.new(1, 1, 1), Text = "", AutoButtonColor = false }, gui)
		corner(fab, 24)
		accentGradient(fab, 45)
		stroke(fab, Color3.new(1, 1, 1), 0.6, 1.5)
		text(fab, { Text = opt.Logo or "R", Size = UDim2.fromScale(1, 1), Font = FONT_BL, TextSize = 20, TextXAlignment = CENTER })
		local fd, fs, fp, moved
		fab.InputBegan:Connect(function(i) if i.UserInputType == TOUCH or i.UserInputType == MB1 then fd, fs, fp, moved = true, i.Position, fab.Position, false end end)
		W:_conn(UIS.InputChanged:Connect(function(i)
			if fd and (i.UserInputType == TOUCH or i.UserInputType == MOVE) then
				local d = i.Position - fs
				if d.Magnitude > 6 then moved = true end
				fab.Position = UDim2.new(fp.X.Scale, fp.X.Offset + d.X, fp.Y.Scale, fp.Y.Offset + d.Y)
			end
		end))
		W:_conn(UIS.InputEnded:Connect(function(i)
			if fd and (i.UserInputType == TOUCH or i.UserInputType == MB1) then
				fd = false
				if not moved then W:Toggle() end
			end
		end))
	end

	-- dialogs ("are you sure?")
	function W:Dialog(o)
		o = o or {}
		local dim = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 50 }, main)
		corner(dim, 16)
		local content2 = tostring(o.Content or "")
		local th = TextService:GetTextSize(content2, 12, FONT, Vector2.new(292, 1000)).Y
		local box = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(330, 104 + th), BackgroundColor3 = Theme.Surface,
			ZIndex = 51 }, dim)
		corner(box, 12)
		gloss(box)
		stroke(box, Theme.Accent, 0.5)
		local bscale = new("UIScale", { Scale = 0.85 }, box)
		text(box, { Text = o.Title or "Are you sure?", Position = UDim2.fromOffset(18, 14), Size = UDim2.new(1, -36, 0, 20), Font = FONT_BL, TextSize = 16, ZIndex = 52 })
		text(box, { Text = content2, Position = UDim2.fromOffset(18, 40), Size = UDim2.new(1, -36, 0, th), Font = FONT, TextSize = 12, TextColor3 = Theme.Dim, TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 52 })
		local row = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 18, 1, -14), Size = UDim2.new(1, -36, 0, 32), BackgroundTransparency = 1, ZIndex = 52 }, box)
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder }, row)
		local function close()
			tween(dim, 0.2, { BackgroundTransparency = 1 })
			tween(bscale, 0.2, { Scale = 0.85 })
			task.delay(0.2, function() dim:Destroy() end)
		end
		for i, b in ipairs(o.Buttons or { { "OK" } }) do
			local primary = i == 1
			local btn = new("TextButton", { Size = UDim2.fromOffset(96, 32), BackgroundColor3 = primary and Color3.new(1, 1, 1) or Theme.Surface3, Text = b[1] or "OK", Font = FONT_B,
				TextSize = 13, TextColor3 = Theme.Text, AutoButtonColor = true, LayoutOrder = i, ZIndex = 53 }, row)
			corner(btn, 8)
			if primary then accentGradient(btn) else stroke(btn, Theme.Stroke) end
			btn.MouseButton1Click:Connect(function() close() if b[2] then task.spawn(b[2]) end end)
		end
		tween(dim, 0.25, { BackgroundTransparency = 0.45 })
		tween(bscale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		return { Close = close }
	end
	closeB.MouseButton1Click:Connect(function()
		W:Dialog({ Title = "Close " .. title .. "?", Content = "The window and everything it runs will be removed.", Buttons = { { "Close", function() W:Destroy() end }, { "Cancel" } } })
	end)

	-- watermark: name · fps · ping · time
	function W:Watermark(on)
		if on == false then
			if W._wm then W._wm:Destroy() W._wm = nil end
			if W._wmConn then W._wmConn:Disconnect() W._wmConn = nil end
			return
		end
		if W._wm then return end
		local wm = new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 56), Size = UDim2.fromOffset(0, 30), AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = Theme.Surface, BackgroundTransparency = 0.1 }, gui)
		corner(wm, 9)
		gloss(wm)
		local wst = stroke(wm, Theme.Accent, 0.5)
		onAccent(function() wst.Color = Theme.Accent end)
		pad(wm, 8, 12)
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder }, wm)
		local d = new("Frame", { Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = 1 }, wm)
		corner(d, 5)
		accentGradient(d, 45)
		text(d, { Text = opt.Logo or "R", Size = UDim2.fromScale(1, 1), Font = FONT_BL, TextSize = 10, TextXAlignment = CENTER })
		local l = text(wm, { Text = title, Size = UDim2.fromOffset(0, 30), AutomaticSize = Enum.AutomaticSize.X, Font = FONT_B, TextSize = 12, LayoutOrder = 2 })
		W._wm = wm
		local frames, acc = 0, 0
		W._wmConn = RunService.RenderStepped:Connect(function(dt)
			frames += 1
			acc += dt
			if acc >= 0.5 then
				local fps = math.floor(frames / acc + 0.5)
				frames, acc = 0, 0
				local ping = 0
				pcall(function() ping = math.floor(lp:GetNetworkPing() * 1000) end)
				l.Text = ("%s   |   %d fps   |   %d ms   |   %s"):format(title, fps, ping, os.date("%H:%M:%S"))
			end
		end)
		W:_conn(W._wmConn)
	end

	-- tabs
	local function applySearch()
		if not W.Current then return end
		local q = search.Text:lower()
		for _, ch in ipairs(W.Current._container:GetChildren()) do
			if ch:IsA("GuiObject") then
				if q == "" then ch.Visible = true
				elseif ch:GetAttribute("RX_Section") then ch.Visible = false
				elseif ch:GetAttribute("RX_Name") then ch.Visible = ch:GetAttribute("RX_Name"):lower():find(q, 1, true) ~= nil end
			end
		end
	end
	search:GetPropertyChangedSignal("Text"):Connect(applySearch)
	function W:SelectTab(T)
		for _, t in ipairs(W.Tabs) do
			local on = t == T
			t._page.Visible = on
			local x = t._btn
			tween(x.b, 0.25, { BackgroundTransparency = on and 0.45 or 1 })
			tween(x.ind, 0.3, { Size = UDim2.fromOffset(3, on and 18 or 0) }, Enum.EasingStyle.Back)
			tween(x.nm, 0.2, { TextColor3 = on and Theme.Text or Theme.Dim })
			if x.ic:IsA("ImageLabel") then tween(x.ic, 0.2, { ImageColor3 = on and Theme.Text or Theme.Dim }) else tween(x.ic, 0.2, { TextColor3 = on and Theme.Text or Theme.Dim }) end
		end
		pageTitle.Text, pageDesc.Text = T._name, T._desc
		pageTitle.TextTransparency, pageDesc.TextTransparency = 1, 1
		tween(pageTitle, 0.3, { TextTransparency = 0 })
		tween(pageDesc, 0.3, { TextTransparency = 0 })
		T._container.Position = UDim2.fromOffset(16, 10)
		tween(T._container, 0.35, { Position = UDim2.fromOffset(16, 0) })
		W.Current = T
		applySearch()
	end
	function W:Tab(o)
		o = type(o) == "string" and { Name = o } or (o or {})
		local T = setmetatable({ _window = W, _order = 0, _name = o.Name or "Tab", _desc = o.Desc or "" }, Elements)
		local b = new("TextButton", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Theme.Surface3, BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
			LayoutOrder = #W.Tabs + 1 }, tabList)
		corner(b, 10)
		local ind = new("Frame", { Size = UDim2.fromOffset(3, 0), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0 }, b)
		corner(ind, 2)
		accentGradient(ind, 90)
		local ic
		if type(o.Icon) == "string" and o.Icon:find("rbxasset") then
			ic = new("ImageLabel", { Position = UDim2.fromOffset(16, 11), Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, Image = o.Icon, ImageColor3 = Theme.Dim }, b)
		else
			ic = text(b, { Text = o.Icon or "•", Position = UDim2.fromOffset(14, 0), Size = UDim2.fromOffset(22, 40), TextXAlignment = CENTER, TextSize = 15, TextColor3 = Theme.Dim })
		end
		local nm = text(b, { Text = T._name, Position = UDim2.fromOffset(46, 0), Size = UDim2.new(1, -52, 1, 0), TextSize = 13, TextColor3 = Theme.Dim })
		b.MouseEnter:Connect(function() if W.Current ~= T then tween(b, 0.15, { BackgroundTransparency = 0.75 }) end end)
		b.MouseLeave:Connect(function() if W.Current ~= T then tween(b, 0.15, { BackgroundTransparency = 1 }) end end)
		local page = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false }, pages)
		local scroll = new("ScrollingFrame", { Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -26, 1, -10), BackgroundTransparency = 1, BorderSizePixel = 0,
			ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y }, page)
		onAccent(function() scroll.ScrollBarImageColor3 = Theme.Accent end)
		new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
		pad(scroll, 2, 10, 2, 16)
		T._container, T._page, T._btn = scroll, page, { b = b, ind = ind, ic = ic, nm = nm }
		b.MouseButton1Click:Connect(function() W:SelectTab(T) end)
		table.insert(W.Tabs, T)
		if #W.Tabs == 1 then W:SelectTab(T) end
		return T
	end

	-- prebuilt settings tab
	function W:SettingsTab()
		local T = W:Tab({ Name = "Settings", Icon = "⚙", Desc = "Themes, keybind and configs" })
		T:Section("Theme")
		local names = {}
		for n in pairs(RedlineX.Themes) do names[#names + 1] = n end
		table.sort(names)
		T:Dropdown({ Name = "Theme preset", Options = names, Default = RedlineX.ThemeName, Callback = function(n) RedlineX:SetTheme(n) end })
		T:ColorPicker({ Name = "Custom accent", Default = Theme.Accent, Callback = function(c) RedlineX:SetAccent(c) end })
		T:Slider({ Name = "Glass", Desc = "how see-through the window is", Min = 0, Max = 60, Default = math.floor(glassT * 100), Step = 1, Suffix = "%",
			Callback = function(v) W:SetTransparency(v / 100) end })
		T:Section("Interface")
		T:Keybind({ Name = "Show / hide", Desc = "toggles this window", Default = W.ToggleKey, Changed = function(k) W.ToggleKey = k end })
		T:Toggle({ Name = "Watermark", Desc = "fps, ping and time in the corner", Default = false, Callback = function(on) W:Watermark(on) end })
		T:Section("Configs")
		local cfgName = "default"
		T:Input({ Name = "Config name", Default = "default", Callback = function(t) if t ~= "" then cfgName = t end end })
		T:Button({ Name = "Save config", Desc = "saves every flagged setting + theme", Callback = function()
			local ok = RedlineX:SaveConfig(cfgName)
			RedlineX:Notify({ Title = ok and "Config saved" or "Save failed", Content = "RedlineX/" .. cfgName .. ".json", Type = ok and "success" or "error", Duration = 3 })
		end })
		T:Button({ Name = "Load config", Desc = "applies a saved config", Callback = function()
			local ok = RedlineX:LoadConfig(cfgName)
			RedlineX:Notify({ Title = ok and "Config loaded" or "No config found", Content = "RedlineX/" .. cfgName .. ".json", Type = ok and "success" or "warning", Duration = 3 })
		end })
		T:Section("Danger zone")
		T:Button({ Name = "Unload", Desc = "closes and removes the window", Callback = function()
			W:Dialog({ Title = "Unload?", Content = "This removes the whole window.", Buttons = { { "Unload", function() W:Destroy() end }, { "Cancel" } } })
		end })
		return T
	end

	-- intro: logo + loading bar, then the window pops in
	local function openWindow()
		holder.Visible = true
		scaler.Scale = baseScale * 0.88
		tween(scaler, 0.5, { Scale = baseScale }, Enum.EasingStyle.Back)
	end
	if opt.Intro ~= false then
		holder.Visible = false
		local splash = new("CanvasGroup", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(280, 150), BackgroundColor3 = Theme.Surface,
			GroupTransparency = 1 }, gui)
		corner(splash, 16)
		stroke(splash, Theme.Stroke)
		local sl = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 20), Size = UDim2.fromOffset(52, 52), BackgroundColor3 = Color3.new(1, 1, 1) }, splash)
		corner(sl, 14)
		accentGradient(sl, 45)
		local slScale = new("UIScale", { Scale = 0.6 }, sl)
		text(sl, { Text = opt.Logo or "R", Size = UDim2.fromScale(1, 1), Font = FONT_BL, TextSize = 26, TextXAlignment = CENTER })
		text(splash, { Text = title, Position = UDim2.fromOffset(0, 80), Size = UDim2.new(1, 0, 0, 20), Font = FONT_BL, TextSize = 16, TextXAlignment = CENTER })
		local loadL = text(splash, { Text = "loading…", Position = UDim2.fromOffset(0, 100), Size = UDim2.new(1, 0, 0, 14), Font = FONT, TextSize = 11, TextColor3 = Theme.Dim,
			TextXAlignment = CENTER })
		local lb = new("Frame", { Position = UDim2.new(0, 40, 1, -22), Size = UDim2.new(1, -80, 0, 4), BackgroundColor3 = Theme.Surface3, BorderSizePixel = 0 }, splash)
		corner(lb, 2)
		local lf = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, lb)
		corner(lf, 2)
		accentGradient(lf)
		task.spawn(function()
			tween(splash, 0.35, { GroupTransparency = 0 })
			tween(slScale, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)
			tween(lf, 1.1, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Quad)
			task.wait(1.15)
			loadL.Text = "ready"
			tween(splash, 0.3, { GroupTransparency = 1 })
			task.wait(0.25)
			splash:Destroy()
			openWindow()
		end)
	else
		openWindow()
	end

	return W
end

return RedlineX
